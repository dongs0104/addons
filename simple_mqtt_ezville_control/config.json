{
  "name": "MQTT 기반 Simple EzVille Wallpad Control",
  "version": "0.0.3",
  "slug": "simple_mqtt_ezville_control",
  "url": "https://github.com/dongs0104/addons",
  "description": "MQTT(EW11 MQTT 모드)로 동작하는 EzVille 월패드 컨트롤러",
  "arch": [
    "armhf",
    "armv7",
    "aarch64",
    "amd64",
    "i386"
  ],
  "map": [
    "share:rw"
  ],
  "startup": "application",
  "boot": "auto",
  "options": {
    "DEBUG_LOG": false,
    "MQTT_LOG": false,
    "EW11_LOG": false,
    "mqtt_server": "192.168.x.x",
    "mqtt_id": "id",
    "mqtt_password": "password",
    "command_interval": 0.5,
    "command_retry_count": 30,
    "first_waittime": 0.5,
    "random_backoff": true,
    "discovery_delay": 0.2,
    "force_update_mode": true,
    "force_update_period": 600,
    "force_update_duration": 2,
    "reboot_control": false,
    "reboot_delay": 300,
    "ew11_timeout": 3600
  },
  "schema": {
    "DEBUG_LOG": "bool",
    "MQTT_LOG": "bool",
    "EW11_LOG": "bool",
    "mqtt_server": "str",
    "mqtt_id": "str",
    "mqtt_password": "str",
    "command_interval": "float",
    "command_retry_count": "int",
    "first_waittime": "float",
    "random_backoff": "bool",
    "discovery_delay": "float",
    "force_update_mode": "bool",
    "force_update_period": "float",
    "force_update_duration": "float",
    "reboot_control": "bool",
    "reboot_delay": "float",
    "ew11_timeout": "float"
  }
}
